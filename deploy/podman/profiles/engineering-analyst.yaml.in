# Agent B (Alice's engineering analyst) egress (scenario 11).
# Two endpoints: the engineering document service B fetches with, and the
# issuer's JWKS host B needs to verify inbound tokens. Without the JWKS
# endpoint every inbound verification is 503 jwks_unavailable.
# Capabilities are profile-configured, never sandbox-chosen.
id: zt2-engineering-analyst-v2
display_name: Zero Trust v2 - Engineering analyst (egress)
description: Alice's engineering-analyst agent fetching engineering documents and the issuer JWKS
category: other
credentials:
  - name: subject_token
    description: Alice's subject token stored for gateway-side token exchange only
    required: true
  - name: access_token
    description: Access token obtained via RFC 8693 token exchange
    required: false
    auth_style: bearer
    header_name: Authorization
    token_grant:
      grant_type: token_exchange
      token_endpoint: http://token-issuer.zt-demo.svc:8080/token
      audience: engineering
      jwt_svid_audience: http://token-issuer.zt-demo.svc:8080
      client_assertion_type: urn:ietf:params:oauth:client-assertion-type:jwt-spiffe
      scopes: [engineering]
      cache_ttl_seconds: 60
      subject_token:
        source: provider_credential
        credential: subject_token
        subject_token_type: urn:ietf:params:oauth:token-type:access_token
      audience_overrides:
        - host: @DOC_HOST@
          port: @DOC_PORT@
          audience: engineering
          scopes: [engineering]
endpoints:
  - host: @DOC_HOST@
    port: @DOC_PORT@
    @ALLOWED_IPS@
    protocol: rest
    access: read-write
    enforcement: enforce
  # The JWKS fetch is ordinary egress through B's own supervisor.
  - host: @ISSUER_HOST@
    port: @ISSUER_PORT@
    @ALLOWED_IPS@
    protocol: rest
    access: read-only
    enforcement: enforce
binaries:
  - /usr/local/bin/docsclaw
