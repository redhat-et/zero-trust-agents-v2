# Agent C (hr analyst): the negative peer. It accepts only hr-analyst
# tokens, so an engineering-analyst token replayed at it is refused with
# 403 invalid_audience before any model call happens.
tools:
  allowed: [fetch_document]
  workspace: /workspace

document_services:
  hr: http://@DOC_HOST@:@DOC_PORT@

inbound_auth:
  enabled: true
  issuer: http://token-issuer.zt-demo.svc:8080
  jwks_url: @JWKS_URL@
  audience: hr-analyst
  required_scopes: [hr]
  allowed_callers:
    - @CALLER_SVID@
