# Agent B (engineering analyst). Rendered per run: the caller allowlist
# is the exact sandbox SVID of agent A, and the document/JWKS hosts are
# driver-specific. Delivered with `sandbox upload`, never baked into an
# image, because sandbox IDs are per-run UUIDs.
tools:
  allowed: [fetch_document]
  workspace: /workspace

document_services:
  engineering: http://@DOC_HOST@:@DOC_PORT@

inbound_auth:
  enabled: true
  # Must equal the deployment's ACCESS_TOKEN_ISSUER exactly, including
  # the port, or every token fails invalid_issuer.
  issuer: http://token-issuer.zt-demo.svc:8080
  jwks_url: @JWKS_URL@
  audience: engineering-analyst
  required_scopes: [engineering]
  allowed_callers:
    - @CALLER_SVID@
